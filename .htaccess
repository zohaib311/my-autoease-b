Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)$ /index.php?_route=/$1 [QSA,L]
</IfModule>

<FilesMatch "^(\.env|app_config\.php|composer\.(json|lock)|nixpacks\.toml|nginx\.template\.conf|\.railwayignore)$">
    Require all denied
</FilesMatch>

<Files "secret.key">
    Require all denied
</Files>
