APP_ENV=production
APP_URL=https://your-profreehost-domain.com

# Your React/frontend URL. Add multiple allowed origins with commas if needed.
API_URL=https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:3000
FRONTEND_URL=https://your-frontend-domain.com

# ProFreeHost MySQL values from Control Panel > MySQL Databases.
DB_HOST=sqlXXX.epizy.com
DB_NAME=epiz_XXXXXXXX_autoease
DB_USER=epiz_XXXXXXXX
DB_PASS=your_database_password
DB_PORT=3306

STRIPE_SECRET_KEY=sk_test_or_live_your_key
